{
  "name": "editable.ts",
  "version": "1.1.1",
  "description": "Friendly contenteditable API - A TypeScript library for block-level rich text editing with a clean, event-driven architecture",
  "keywords": [
    "block-editor",
    "cms-editor",
    "contenteditable",
    "editable",
    "editor",
    "inline-editor",
    "range",
    "rich-text",
    "rich-text-editor",
    "selection",
    "text-editing",
    "typescript",
    "typescript-editor",
    "wysiwyg",
    "wysiwyg-editor"
  ],
  "homepage": "https://watzak.github.io/editable.ts/examples/",
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watzak/editable.ts.git"
  },
  "files": [
    "lib",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/core.js",
  "module": "./lib/core.js",
  "types": "./lib/core.d.ts",
  "exports": {
    ".": {
      "types": "./lib/core.d.ts",
      "import": "./lib/core.js",
      "default": "./lib/core.js"
    },
    "./features": {
      "types": "./lib/features.d.ts",
      "import": "./lib/features.js",
      "default": "./lib/features.js"
    },
    "./dist/editable.umd.cjs": {
      "default": "./dist/editable.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --config vite/vite.config.docs.mjs",
    "dev:e2e": "vite --config vite/vite.config.docs.mjs --host 127.0.0.1 --port 9050 --strictPort",
    "build:ts": "rimraf ./lib && tsc",
    "build:dist": "rimraf ./dist && vite build --config vite/vite.config.dist.mjs",
    "build:docs": "rimraf ./examples/dist && vite build --config vite/vite.config.docs.bundle.mjs && vite build --config vite/vite.config.docs.styles.mjs",
    "capture:readme": "node scripts/capture-readme-demo.mjs",
    "build": "npm run build:ts -s && npm run build:dist -s && npm run build:docs -s",
    "prepublishOnly": "npm run build -s",
    "test:ci": "vitest run",
    "test": "vitest run",
    "posttest": "npm run lint -s && npm run fmt:check -s",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "release": "commit-and-tag-version && git push --follow-tags && npm publish"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@preact/preset-vite": "2.10.5",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.2",
    "@vitest/ui": "4.1.2",
    "commit-and-tag-version": "12.7.3",
    "jsdom": "29.0.1",
    "normalize.css": "8.0.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.68.0",
    "preact": "10.29.0",
    "prismjs": "1.30.0",
    "prop-types": "15.8.1",
    "rimraf": "6.1.3",
    "terser": "5.46.1",
    "typescript": "6.0.2",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "4.0.1",
    "vitest": "4.1.2"
  },
  "overrides": {
    "rimraf": "6.1.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  }
}
