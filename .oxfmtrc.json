{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "none",
  "endOfLine": "lf",
  "printWidth": 100,
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "examples/dist/**",
    "lib/**",
    "node_modules/**",
    "package-lock.json"
  ]
}
