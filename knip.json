{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/core.ts",
    "src/features.ts",
    "spec/**/*.spec.ts",
    "spec/types/**/*.test-d.ts",
    "e2e/**/*.ts",
    "examples/index.js",
    "examples/e2e-editor-flows.js",
    "examples/e2e-iframe-editor.js",
    "examples/events.jsx",
    "examples/styles-entry.js",
    "scripts/**/*.mjs",
    "vite/**/*.{js,mjs}",
    "vitest.config.js",
    "playwright.config.ts"
  ],
  "project": [
    "src/**/*.ts",
    "spec/**/*.ts",
    "e2e/**/*.ts",
    "examples/**/*.{js,jsx}",
    "scripts/**/*.mjs",
    "vite/**/*.{js,mjs}",
    "*.config.{js,ts}"
  ],
  "ignore": ["spec/test-globals.d.ts"],
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "@vitest/ui",
    "commit-and-tag-version",
    "normalize.css",
    "oxfmt",
    "oxlint",
    "preact",
    "rimraf",
    "size-limit",
    "terser",
    "typescript"
  ]
}
